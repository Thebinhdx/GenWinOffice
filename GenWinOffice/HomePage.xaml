<Page x:Class="GenWinOffice.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="HomePage" xmlns:genwinoffice="clr-namespace:GenWinOffice;assembly=GenWinOffice">
  <Grid>
    <ScrollViewer Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24">
        <Border Background="#1E1E2C" CornerRadius="12" Padding="28,24" Margin="0,0,0,24" BorderBrush="#2D2D3D" BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <Border Background="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left" CornerRadius="4" Padding="8,3" Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource Home_Tag}" FontSize="11" FontWeight="Bold" Foreground="#FF000000" />
              </Border>
              <TextBlock Text="{DynamicResource Home_Title}" FontSize="28" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,8" />
              <TextBlock Text="{DynamicResource Home_Subtitle}" Foreground="#B0B0B0" FontSize="14" TextWrapping="Wrap" MaxWidth="650" HorizontalAlignment="Left" LineHeight="20" />
              <ui:Button Name="BtnGoToScan" Content="{DynamicResource Home_StartScan}" Appearance="Primary" Margin="0,20,0,0" Padding="20,10" FontSize="14" Icon="{ui:SymbolIcon ArrowRight24}" Click="BtnGoToScan_Click" />
            </StackPanel>
            <ui:SymbolIcon Grid.Column="1" Symbol="ShieldCheckmark48" FontSize="96" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Opacity="0.8" VerticalAlignment="Center" Margin="20,0,10,0" />
          </Grid>
        </Border>
        <TextBlock Text="{DynamicResource Home_Features_Title}" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFFFF" Margin="0,0,0,14" />
        <UniformGrid Columns="3" Margin="0,0,0,24">
          <ui:Card Margin="0,0,6,0" Padding="16">
            <StackPanel>
              <ui:SymbolIcon Symbol="LockClosed24" FontSize="28" Foreground="#4CAF50" Margin="0,0,0,12" HorizontalAlignment="Left" />
              <TextBlock Text="{DynamicResource Home_Feature1_Title}" FontWeight="Bold" Foreground="#FFFFFFFF" FontSize="14" Margin="0,0,0,6" />
              <TextBlock Text="{DynamicResource Home_Feature1_Desc}" Foreground="#808080" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
            </StackPanel>
          </ui:Card>
          <ui:Card Margin="3,0,3,0" Padding="16">
            <StackPanel>
              <ui:SymbolIcon Symbol="Search24" FontSize="28" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,12" HorizontalAlignment="Left" />
              <TextBlock Text="{DynamicResource Home_Feature2_Title}" FontWeight="Bold" Foreground="#FFFFFFFF" FontSize="14" Margin="0,0,0,6" />
              <TextBlock Text="{DynamicResource Home_Feature2_Desc}" Foreground="#808080" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
            </StackPanel>
          </ui:Card>
          <ui:Card Margin="6,0,0,0" Padding="16">
            <StackPanel>
              <ui:SymbolIcon Symbol="Desktop24" FontSize="28" Foreground="#FFB900" Margin="0,0,0,12" HorizontalAlignment="Left" />
              <TextBlock Text="{DynamicResource Home_Feature3_Title}" FontWeight="Bold" Foreground="#FFFFFFFF" FontSize="14" Margin="0,0,0,6" />
              <TextBlock Text="{DynamicResource Home_Feature3_Desc}" Foreground="#808080" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
            </StackPanel>
          </ui:Card>
        </UniformGrid>
        <TextBlock Text="{DynamicResource Home_Detection_Title}" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFFFF" Margin="0,0,0,14" />
        <StackPanel Margin="0,0,0,24">
          <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Globe24}">
            <ui:CardControl.Header>
              <StackPanel>
                <TextBlock Text="{DynamicResource Home_KMS_Title}" FontWeight="Bold" Foreground="#FFFFFFFF" />
                <TextBlock Text="{DynamicResource Home_KMS_Desc}" Foreground="#808080" FontSize="12" />
              </StackPanel>
            </ui:CardControl.Header>
            <Border Background="#1E382B" CornerRadius="4" Padding="8,4">
              <TextBlock Text="{DynamicResource Status_Supported}" Foreground="#4CAF50" FontSize="11" FontWeight="Bold" />
            </Border>
          </ui:CardControl>
          <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon DocumentBulletList24}">
            <ui:CardControl.Header>
              <StackPanel>
                <TextBlock Text="{DynamicResource Home_Ohook_Title}" FontWeight="Bold" Foreground="#FFFFFFFF" />
                <TextBlock Text="{DynamicResource Home_Ohook_Desc}" Foreground="#808080" FontSize="12" />
              </StackPanel>
            </ui:CardControl.Header>
            <Border Background="#1E382B" CornerRadius="4" Padding="8,4">
              <TextBlock Text="{DynamicResource Status_Supported}" Foreground="#4CAF50" FontSize="11" FontWeight="Bold" />
            </Border>
          </ui:CardControl>
          <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Key24}">
            <ui:CardControl.Header>
              <StackPanel>
                <TextBlock Text="{DynamicResource Home_HWID_Title}" FontWeight="Bold" Foreground="#FFFFFFFF" />
                <TextBlock Text="{DynamicResource Home_HWID_Desc}" Foreground="#808080" FontSize="12" />
              </StackPanel>
            </ui:CardControl.Header>
            <Border Background="#1E382B" CornerRadius="4" Padding="8,4">
              <TextBlock Text="{DynamicResource Status_Supported}" Foreground="#4CAF50" FontSize="11" FontWeight="Bold" />
            </Border>
          </ui:CardControl>
          <ui:CardControl Icon="{ui:SymbolIcon Wrench24}">
            <ui:CardControl.Header>
              <StackPanel>
                <TextBlock Text="{DynamicResource Home_Reg_Title}" FontWeight="Bold" Foreground="#FFFFFFFF" />
                <TextBlock Text="{DynamicResource Home_Reg_Desc}" Foreground="#808080" FontSize="12" />
              </StackPanel>
            </ui:CardControl.Header>
            <Border Background="#382B1E" CornerRadius="4" Padding="8,4">
              <TextBlock Text="{DynamicResource Status_InDev}" Foreground="#FFC107" FontSize="11" FontWeight="Bold" />
            </Border>
          </ui:CardControl>
        </StackPanel>
        <Border BorderBrush="#2D2D3D" BorderThickness="0,1,0,0" Padding="0,20,0,10" Margin="0,10,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="GenuineWinOffice Checker © 2026" Foreground="#808080" FontSize="12" VerticalAlignment="Center" />
            <ui:HyperlinkButton Grid.Column="1" Content="{DynamicResource Home_GitHub}" FontSize="12" Icon="{ui:SymbolIcon Code24}" Click="BtnGithub_Click" />
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>