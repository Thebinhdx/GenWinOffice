<Page x:Class="GenWinOffice.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="SettingsPage" xmlns:genwinoffice="clr-namespace:GenWinOffice;assembly=GenWinOffice">
    <ScrollViewer Background="Transparent" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="{DynamicResource Settings_Title}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
            <TextBlock Text="{DynamicResource Settings_Subtitle}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="13" Margin="0,0,0,24" />
            <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon LocalLanguage24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_Language}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Settings_Language_Desc}" Foreground="{DynamicResource TextDescriptionBrush}" FontSize="12" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox Name="LanguageComboBox" SelectedIndex="0" Width="160" SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBoxItem Content="English" Tag="en-US" />
                    <ComboBoxItem Content="Tiếng Việt" Tag="vi-VN" />
                </ComboBox>
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Color24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_Theme}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Settings_Theme_Desc}" Foreground="{DynamicResource TextDescriptionBrush}" FontSize="12" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox Name="ThemeComboBox" Width="160" SelectionChanged="ThemeComboBox_SelectionChanged">
                    <ComboBoxItem Content="System Default" Tag="SystemDefault" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                </ComboBox>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>