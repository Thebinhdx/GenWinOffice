<ui:FluentWindow x:Class="GenWinOffice.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:GenWinOffice" Title="GenWinOffice" Height="650" Width="1000" MinWidth="800" MinHeight="500" WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" SizeChanged="FluentWindow_SizeChanged">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Grid}">
          <Style.Triggers>
            <DataTrigger Value="False" Binding="{Binding Path=IsActive, RelativeSource={RelativeSource AncestorType=Window}}">
              <Setter Property="UIElement.Opacity" Value="0.5" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,12,0" ZIndex="99">
        <ui:Button Name="PaneToggleButton" Appearance="Transparent" Width="36" Height="32" Padding="0" BorderThickness="0" FontSize="16" Icon="{ui:SymbolIcon Navigation24}" Click="PaneToggleButton_Click" />
        <TextBlock Text="GenWinOffice" Foreground="#FFFFFFFF" FontFamily="Segoe UI Variable Display" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" />
      </StackPanel>
      <Grid Column="1">
        <ui:TitleBar Name="AppTitleBar" Title="" Foreground="#FFFFFFFF" />
        <ui:TextBox Name="SearchTextBox" WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="99" Width="360" Height="32" Margin="0,4,0,4" HorizontalAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="8,0,8,2" PlaceholderText="Coming Soon..." Icon="{ui:SymbolIcon Search24}" />
      </Grid>
    </Grid>
    <ui:NavigationView Name="RootNavigation" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsPaneToggleVisible="False" BorderThickness="0" VerticalAlignment="Stretch">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="{DynamicResource Nav_Home}" TargetPageType="{x:Type local:HomePage}" Icon="{ui:SymbolIcon Home24}" />
        <ui:NavigationViewItem Content="{DynamicResource Nav_Scan}" TargetPageType="{x:Type local:ScanPage}" Icon="{ui:SymbolIcon DesktopCursor24}" />
      </ui:NavigationView.MenuItems>
      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem Content="{DynamicResource Nav_Settings}" TargetPageType="{x:Type local:SettingsPage}" Icon="{ui:SymbolIcon Settings24}" />
      </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>
  </Grid>
</ui:FluentWindow>